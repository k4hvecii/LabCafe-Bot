{
  "name": "labcafe-discord-bot-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Windows / Linux compatible, minimal and security-minded Discord bot base",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "test": "node --import tsx --test",
    "doctor": "tsx src/cli/doctor.ts",
    "predashboard": "npm run build",
    "dashboard": "node dist/cli/dashboard.js",
    "commands:register": "tsx src/cli/register.ts",
    "style:preview": "tsx src/cli/name-style.ts preview",
    "style:apply": "tsx src/cli/name-style.ts apply",
    "style:reset": "tsx src/cli/name-style.ts reset"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "echarts": "6.1.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
