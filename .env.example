DISCORD_TOKEN=BOT_TOKEN_BURAYA
DISCORD_CLIENT_ID=APPLICATION_ID_BURAYA
DISCORD_GUILD_ID=
LOG_LEVEL=info
STYLE_GUILD_IDS=

# Optional custom Discord emojis. Leave blank for text-only headings.
# Example format: <:success:123456789012345678>
EMBED_EMOJI_SUCCESS=
EMBED_EMOJI_ERROR=
EMBED_EMOJI_INFO=

# Web dashboard (OAuth2 client secret is NOT the bot token).
# Optional shared settings file for independent bot/web services.
# LABCAFE_SETTINGS_PATH=/var/lib/labcafe/settings.sqlite
DISCORD_CLIENT_SECRET=
DASHBOARD_ORIGIN=http://localhost:3000
DASHBOARD_HOST=127.0.0.1
# Optional internal listen port (useful behind an HTTPS reverse proxy).
DASHBOARD_PORT=3000

# Optional support guild; falls back to DISCORD_GUILD_ID, or the only bot guild.
DASHBOARD_SUPPORT_GUILD_ID=

# Optional support server invitation shown before Discord login.
DASHBOARD_SUPPORT_INVITE_URL=

# Bot readiness listens only on loopback (separate from dashboard).
BOT_HEALTH_PORT=3001

# Owner-only dashboard; Discord user ID, never a role or guild ID.
LABCAFE_OWNER_ID=
# Enable only behind a local nginx that overwrites X-Real-IP.
DASHBOARD_TRUST_LOOPBACK_PROXY=false

# true: register commands in every joined guild allowed by the beta policy.
# false/empty: preserve DISCORD_GUILD_ID or global scope.
DISCORD_REGISTER_JOINED_GUILDS=false

# Optional Control Center. Leave disabled unless explicitly configured.
LABCAFE_INSTALL_FLOW=false
LABCAFE_OBSERVABILITY_TOKEN=
LABCAFE_OBSERVER_PORT=3002
LABCAFE_WEB_CONTROL_PATH=
LABCAFE_BOT_CONTROL_PATH=
# Observer is Linux-specific; keep its exporter on loopback.
